#!/bin/sh
# pre-push hook: run the test suite against the real Windows native binaries
# before pushing. See docs/adr/0001-test-execution-topology.md.
#
# This hook is versioned under .githooks/. Activate it in a fresh clone with:
#   git config core.hooksPath .githooks
#
# The product is a Windows app, so the authoritative pass runs under the
# project's Windows venv (invoked via WSL interop from a Linux/WSL shell).
# Override the interpreter:   WIN_PY=/path/to/python.exe
# Skip entirely:              git push --no-verify

WIN_PY="${WIN_PY:-.venv/Scripts/python.exe}"

echo "Running pre-push test suite under $WIN_PY (ADR 0001)..."

# -x stops on first failure for speed.
result=$(timeout 240 "$WIN_PY" -m pytest -m "not slow" --tb=line -q -x \
    --timeout=60 -p no:qt 2>&1)
exit_code=$?

echo "$result" | tail -5

# PyQt6 teardown may return non-zero even when all tests pass.
if [ $exit_code -ne 0 ]; then
    if echo "$result" | grep -q "failed"; then
        echo ""
        echo "BLOCKED: Test failures detected. Fix before pushing."
        exit 1
    fi
    # No "failed" in output — teardown-only crash, allow push
    echo "Tests passed (ignoring PyQt6 teardown exit code)"
fi

echo "OK: All tests pass"
exit 0
